{
    "name": "gp10devhts/laravel-awardable",
    "description": "A Laravel package to add award functionality to any model.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "gp10devhts",
            "email": "gp10devhts@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "orchestra/testbench": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Gp10devhts\\Awardable\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gp10devhts\\Awardable\\AwardableServiceProvider"
            ]
        }
    }
}
